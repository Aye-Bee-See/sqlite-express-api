# Copy to .env and fill in. .env is git-ignored.

# Secret used to sign and verify login tokens. Required.
JWT_SECRET=replace-with-a-long-random-string

# Port the API listens on. Required.
PORT=3000

# First administrator. On boot, if no user with this username exists it is
# created with the admin role. All three must be set for this to happen.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-at-least-7-chars
ADMIN_EMAIL=admin@example.com
