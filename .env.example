# Copy to .env and fill in. .env is git-ignored.

# Secret used to sign and verify login tokens. Required.
JWT_SECRET=replace-with-a-long-random-string

# Port the API listens on. Required.
PORT=3000

# First administrator. On boot, if no user with this username exists it is
# created with the admin role. All three must be set for this to happen.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-at-least-7-chars
ADMIN_EMAIL=admin@example.com

# Browser origins allowed by CORS, comma-separated. Default: the local front end.
CORS_ORIGIN=http://localhost:3001

# Database behaviour. Data lives in ./database.sqlite.
# DB_RESET=true drops every table and replays all migrations on boot (all data is lost).
# DB_SEED=false skips loading the seed files into empty tables.
# DB_LOGGING=true prints every SQL statement.
# Development only: the statements carry their values (password hashes, token
# hashes, wrapped keys, and in server mode nothing else protects what is logged).
DB_RESET=false
DB_SEED=true
DB_LOGGING=false
# DB_STORAGE=database.sqlite   # path to the SQLite file; ':memory:' for a throwaway database

# Attachments (scans of replies, enclosures). Files are stored on disk under
# UPLOAD_DIR (relative to the working directory, or absolute); back it up with
# the database. UPLOAD_MAX_BYTES caps one upload (default 20 MiB).
# UPLOAD_DIR=uploads
# UPLOAD_MAX_BYTES=20971520

# Letter encryption. In `server` mode (the default) every letter body, relay
# note, and attachment is encrypted with its own content key, and that key is
# wrapped with ENCRYPTION_KEY. Generate a key with `npm run keygen`, keep it
# out of git, and back it up: without it the letters cannot be read. In `e2e`
# mode browsers hold the keys and the server stores ciphertext only; switch
# with `npm run encryption:rewrap` (see README, Encryption).
ENCRYPTION_MODE=server
ENCRYPTION_KEY=replace-with-the-output-of-npm-run-keygen
# Only while changing ENCRYPTION_KEY (README, "Encryption"): the OLD key, so that
# letters wrapped with it stay readable until `npm run encryption:rekey` is done.
# ENCRYPTION_KEY_PREVIOUS=

# Retention. Letters are deleted this many days after being mailed (replies
# after being recorded) unless the writer chose a different window or pinned
# the letter. 0 keeps everything. RETENTION_MAX_DAYS, when set, caps what a
# writer may choose (including "forever"); it must be at least 1. Preview with
# `npm run retention -- --dry-run`.
RETENTION_DEFAULT_DAYS=90
# RETENTION_MAX_DAYS=365

# Push notifications (content-free: a push only says "sync"). Point this at a
# Firebase service-account key kept OUTSIDE the repository. Unset: devices may
# register and nothing is sent. The two alert strings are the only visible
# words a push carries (iOS only); keep them bland.
# FCM_SERVICE_ACCOUNT_FILE=/etc/ayebeesee/firebase-service-account.json
# PUSH_IOS_ALERT_TITLE=New activity
# PUSH_IOS_ALERT_BODY=Open the app to see it.
# NOTIFICATION_DAYS=30

# How long an Idempotency-Key (sent with a letter so a retry cannot mail a
# second copy) is remembered.
# IDEMPOTENCY_DAYS=30

# How many days a claim code (handed to a newcomer at a letter night) works.
# CLAIM_TOKEN_DAYS=14

# Refuse to make any new account that would send its password to the server
# (authScheme "plain"). Set once every client signs in with the split scheme
# (README, "Signing in without sending the password").
# REQUIRE_SPLIT_AUTH=false

# Invitations. A token works for INVITATION_DAYS. A group that joins by
# invitation waits for an admin to activate it unless
# INVITATION_AUTO_ACTIVATE=true, which lets the vouching group's word suffice.
# INVITATION_DAYS=14
# INVITATION_AUTO_ACTIVATE=false

# Rate limits on the unauthenticated endpoints (login, claim check, invitations, recovery).
# Counts are per window; a limited request gets 429 with Retry-After. These
# are the defaults; uncomment to change. RATE_LIMIT_ENABLED=false turns it off.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN_FAILURES_PER_USER=10
# RATE_LIMIT_LOGIN_PER_IP=60
# RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
# RATE_LIMIT_CLAIM_PER_IP=20
# RATE_LIMIT_CLAIM_WINDOW_MINUTES=60
# RATE_LIMIT_INVITE_PER_IP=20
# RATE_LIMIT_INVITE_WINDOW_MINUTES=60
# RATE_LIMIT_RECOVER_START_PER_USER=5
# RATE_LIMIT_RECOVER_START_PER_IP=30
# RATE_LIMIT_RECOVER_FINISH_PER_USER=5
# RATE_LIMIT_RECOVER_FINISH_PER_IP=30
# RATE_LIMIT_RECOVER_WINDOW_MINUTES=60

# Largest body of POST /auth/chapter-rotation, in bytes (a rotation re-seals every
# letter of a group in one request). Default 32 MB.
# ROTATION_MAX_BYTES=33554432
# Behind a reverse proxy, tell Express how many hops to trust so limits key on
# the real client address (1 for one proxy such as nginx or Caddy).
# TRUST_PROXY=1

# NODE_ENV=development adds error messages and stack traces to 500 responses.
# NODE_ENV=development

# Backups (README, "Backups"). The PUBLIC half of a key made with
# `npm run backup:keygen` on your own computer, never on the server: the server
# can then make backups and cannot open them. Without it no backups are made.
# BACKUP_PUBLIC_KEY=
# Where they are written (ideally another disk), and how many to keep.
# BACKUP_DIR=backups
# BACKUP_KEEP=14
# Let the running server make one whenever the newest is older than this many
# hours. Leave unset when cron runs `npm run backup`.
# BACKUP_EVERY_HOURS=24
